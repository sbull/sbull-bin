#!/bin/bash
CONTAINER=$1
REMOTE=$2
DATABASE=$3
TABLE=$4
KEEP_FILE=$5
set -e
set -o pipefail

if [[ -n $CONTAINER ]] && [[ -n $REMOTE ]] && [[ -n $DATABASE ]] && [[ -n $TABLE ]]; then
  set -x
  TS=`date +%Y%m%d%H%M%S`
  FILE=${TABLE}-${TS}.txt
  BACKUP=${TABLE}_${TS}
  echo "\\copy $TABLE to '$FILE'" | heroku pg:psql $DATABASE --remote $REMOTE
  if ! docker exec -i $CONTAINER cmp -s - "$FILE" < "$FILE"; then
    { set +x; } 2>/dev/null
    echo "ERROR: $FILE is not readable, or differs, from inside $CONTAINER (relative to its working directory). Is the container mounting this directory? Nothing was changed in the local database." >&2
    exit 1
  fi
  ROWS=$(wc -l < "$FILE")
  docker exec -i $CONTAINER rails db -p <<SQL
\set ON_ERROR_STOP on
BEGIN;
CREATE TABLE $BACKUP ( LIKE $TABLE INCLUDING ALL );
INSERT INTO $BACKUP SELECT * FROM $TABLE;
TRUNCATE TABLE $TABLE;
\copy $TABLE from '$FILE'
DO \$\$ BEGIN
  IF (SELECT COUNT(*) FROM $TABLE) <> $ROWS THEN
    RAISE EXCEPTION '$TABLE has % rows but $FILE has $ROWS', (SELECT COUNT(*) FROM $TABLE);
  END IF;
END \$\$;
SELECT setval('${TABLE}_id_seq', GREATEST(1000000000, (SELECT MAX(id) FROM $TABLE), (SELECT MAX(id) FROM $BACKUP)));
COMMIT;
SQL
  if [[ -z $KEEP_FILE ]]; then
    rm $FILE
  fi
else
  echo "Usage: `basename $0` <rails-docker-container> <heroku-remote> <heroku-database> <table> <keep-file-flag>"
  exit 1
fi
